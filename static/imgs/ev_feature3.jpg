<!DOCTYPE html>
<html>
<head>
    <title>Feature 3 Image Placeholder</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #006600;
            color: white;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            text-align: center;
        }
        .placeholder {
            max-width: 80%;
        }
        h1 {
            font-size: 2rem;
            margin-bottom: 1rem;
        }
    </style>
</head>
<body>
    <div class="placeholder">
        <h1>Nationwide Charging Network</h1>
        <p>1000+ charging stations</p>
    </div>
</body>
</html>